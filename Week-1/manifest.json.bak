{
  "manifest_version": 3,
  "name": "Sahayak",
  "version": "0.1.0",
  "description": "AI-powered Chrome side-panel browser assistant.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Sahayak",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel/side-panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": [
        "shared/message-contract.js",
        "content/_placeholder.js",
        "content/selection.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
